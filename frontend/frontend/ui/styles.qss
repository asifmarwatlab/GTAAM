/* =========================================================================
   A-GTAAM Terrain Workspace - global stylesheet (GREYSCALE THEME)
   Palette
     G050  #f8f9fa   lightest surface
     G100  #e9ecef   light background
     G200  #dee2e6   divider / light border
     G300  #ced4da   input border / hover fill
     G400  #adb5bd   muted text / disabled
     G500  #495057   body text / secondary accent
     G700  #343a40   strong text / primary buttons / status bar
     G900  #212529   headings / title bar / darkest surface
   ========================================================================= */

* { font-family: "Segoe UI", "Inter", "Helvetica Neue", "Noto Sans", Arial, sans-serif; }
QWidget { font-size: 13.5px; color: #212529; }
QMainWindow, QDialog { background: #e9ecef; }
QDialog { background: #f8f9fa; }

QToolTip {
    background: #f8f9fa;
    color: #343a40;
    border: 1px solid #ced4da;
    padding: 3px 7px;
    font-size: 12.5px;
    font-weight: 700;
}
/* ---------- scroll areas & bars ---------- */
QScrollArea { background: transparent; border: 0; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #ced4da; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #adb5bd; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #ced4da; border-radius: 4px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: #adb5bd; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: #ced4da; }


/* "TERRAIN WORKSPACE" label (objectName = workspaceText) */
#workspaceText {
    color: #f5faff;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

#projectTitle {
    color: #f8f9fa; background: transparent; border: 1px solid transparent;
    border-radius: 7px; padding: 6px 9px; font-size: 14px; font-weight: 600;
}
#projectTitle:hover { background: #626a72; border-color: #adb5bd; }
#projectDot { background: #ced4da; border-radius: 4px; }
#previewTag {
    color: #f8f9fa;
    background: #606367;
    border: 1px solid #626a72;
    border-radius: 10px;
    padding: 3px 11px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}
QToolButton#titleIcon { background: transparent; border: 0; border-radius: 7px; padding: 6px; }
QToolButton#titleIcon:hover { background: #626a72; }

/* .....................layers additional styles.......................  */
#groupHeading:hover { background: #e9ecef; }
#emptyHint { color: #868e96; font-size: 12px; font-style: italic; padding: 6px 8px 6px 22px; }

/* ---------- tab bar ---------- */
#tabbar { background: #e9ecef; border-bottom: 1px solid #dee2e6; }
QPushButton#tabButton {
    background: transparent; border: 0; border-bottom: 3px solid transparent;
    padding: 12px 18px 9px 18px; color: #495057; font-size: 14px; font-weight: 600;
}
QPushButton#tabButton:hover { background: #dee2e6; color: #212529; }
QPushButton#tabButton:checked {
    color: #212529; border-bottom: 3px solid #343a40; background: #f8f9fa;
}

/* ---------- ribbon ---------- */
#ribbon { background: #f8f9fa; border-bottom: 1px solid #dee2e6; }
QToolButton#ribbonButton {
    background: transparent; border: 1px solid transparent; border-radius: 8px;
    padding: 6px 8px 3px 8px; color: #212529; font-size: 12.5px; font-weight: 600;
}
QToolButton#ribbonSmall {
    background: transparent; border: 1px solid transparent; border-radius: 6px;
    padding: 2px 8px; color: #212529; font-size: 12.5px; font-weight: 600; text-align: left;
}
QToolButton#ribbonButton:hover, QToolButton#ribbonSmall:hover {
    background: #e9ecef; border-color: #ced4da;
}
QToolButton#ribbonButton:pressed, QToolButton#ribbonSmall:pressed { background: #dee2e6; }
QToolButton#ribbonButton:checked, QToolButton#ribbonSmall:checked {
    background: #dee2e6; border-color: #adb5bd; color: #212529;
}
#ribbonLabel { color: #495057; font-size: 12px; font-weight: 600; }
#ribbonSeparator { background: #dee2e6; }
#ribbonNote { color: #495057; font-size: 12.5px; font-style: italic; }

/* ---------- side panes ---------- */
#contents { background: #f8f9fa; border-right: 1px solid #dee2e6; }
#inspector { background: #f8f9fa; border-left: 1px solid #dee2e6; }
#paneTitle { background: #e9ecef; border-bottom: 1px solid #dee2e6; min-height: 44px; max-height: 44px; }
#paneTitleText { font-size: 15px; font-weight: 700; color: #343a40; }
QToolButton#iconButton { background: transparent; border: 0; border-radius: 6px; padding: 5px; }
QToolButton#iconButton:hover { background: #dee2e6; }
#contentsSubtitle { color: #495057; padding: 10px 14px 6px 14px; font-size: 12.5px; }
QLineEdit#layerFilter {
    background: #ffffff; border: 1px solid #ced4da; border-radius: 8px; padding: 6px 8px;
}
QLineEdit#layerFilter:focus { border-color: #343a40; }
#contentsTools QLabel { color: #495057; font-size: 12.5px; }
QToolButton#orderButton { border: 0; border-radius: 6px; padding: 4px; background: #e9ecef; }
QToolButton#orderButton:hover { background: #dee2e6; }
#layerCount { color: #495057; font-size: 12.5px; }

#groupHeading { border-radius: 8px; }
#groupHeading:hover { background: #f8f9fa; }
#groupName { font-weight: 700; color: #212529; }
#groupCount {
    background: #dee2e6; color: #343a40; border-radius: 9px; padding: 1px 8px;
    font-size: 11.5px; font-weight: 700;
}
#layerRow { border-radius: 8px; border: 1px solid transparent; }
#layerRow:hover { background: #f8f9fa; }
#layerRow[selected="true"] { background: #e9ecef; border: 1px solid #ced4da; }
#layerName { font-size: 13.5px; font-weight: 600; color: #212529; }
#layerSub { color: #495057; font-size: 12px; }
QToolButton#layerMenu {
    background: transparent; border: 0; border-radius: 6px; padding: 0 6px;
    font-size: 17px; font-weight: 700; color: #495057;
}
QToolButton#layerMenu:hover { background: #dee2e6; color: #212529; }
#legendCaption { color: #495057; font-size: 12px; font-weight: 600; }
#legendTick { color: #495057; font-size: 11.5px; }

/* layer swatches — kept as greyscale data gradients */
#swatch { border-radius: 4px; border: 1px solid rgba(33, 37, 41, 0.25); }
#swatch[kind="dem"] {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #212529, stop:0.35 #495057, stop:0.7 #adb5bd, stop:1 #f8f9fa);
}
#swatch[kind="gray"] { background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #212529, stop:1 #f8f9fa); }
#swatch[kind="slope"] {
    background: qlineargradient(x1:0, y1:1, x2:1, y2:0, stop:0 #f8f9fa, stop:0.5 #adb5bd, stop:1 #343a40);
}
#swatch[kind="vector"] { background: rgba(73, 80, 87, 0.35); border: 2px solid #343a40; }
#swatch[kind="contours"] { background: #f8f9fa; border: 2px solid #495057; }
#swatch[kind="base"] { background: #e9ecef; border: 2px solid #adb5bd; }

#contentsBottom { background: #e9ecef; border-top: 1px solid #dee2e6; min-height: 38px; max-height: 38px; }
#contentsBottom QLabel { color: #495057; font-size: 12.5px; }
#greenDot { background: #495057; border-radius: 4px; }
#amberDot { background: #343a40; border-radius: 4px; }
#tinyDot { background: #495057; border-radius: 3px; }

/* statistics / tool settings */
#eyebrow, #sectionLabel { color: #495057; font-size: 11.5px; font-weight: 700; letter-spacing: 1px; }
#sectionRight { color: #495057; font-size: 12px; }
#selectedLayerTitle { font-size: 15.5px; font-weight: 700; color: #212529; }
#layerDesc { color: #495057; font-size: 12.5px; }
#statCard { background: #ffffff; border: 1px solid #dee2e6; border-radius: 10px; }
#statLabel { color: #495057; font-size: 12px; }
#statValue { font-size: 19px; font-weight: 700; color: #212529; }
#histAxis { color: #495057; font-size: 11.5px; }
#propTable { background: #ffffff; border: 1px solid #dee2e6; border-radius: 10px; }
#propRow { border-bottom: 1px solid #e9ecef; }
#propRow[last="true"] { border-bottom: 0; }
#propKey { color: #495057; font-size: 12.5px; }
#propValue { font-weight: 600; font-size: 12.5px; color: #212529; }
#paneFootnote { color: #495057; font-size: 12px; }
#sliderValue { color: #212529; font-weight: 700; }
#fieldLabel { color: #343a40; font-size: 12.5px; font-weight: 600; }
#formInfo { color: #495057; font-size: 13px; }
#dialogTitle { font-size: 17px; font-weight: 700; color: #212529; }

/* ---------- form controls ---------- */
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background: #ffffff; border: 1px solid #ced4da; border-radius: 7px; padding: 6px 9px;
    selection-background-color: #343a40; selection-color: #f8f9fa;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus { border: 1px solid #343a40; }
QComboBox::drop-down { border: 0; width: 24px; }
QComboBox QAbstractItemView {
    background: #ffffff; border: 1px solid #ced4da; selection-background-color: #e9ecef;
    selection-color: #212529; outline: 0; padding: 3px;
}
QCheckBox { spacing: 8px; padding: 2px 0; }
QSlider::groove:horizontal { height: 6px; background: #dee2e6; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #495057; border-radius: 3px; }
QSlider::handle:horizontal {
    width: 16px; height: 16px; margin: -6px 0; border-radius: 8px;
    background: #343a40; border: 2px solid #ffffff;
}
QPushButton#primaryButton {
    background: #343a40; color: #f8f9fa; border: 0; border-radius: 8px;
    padding: 8px 20px; font-weight: 700;
}
QPushButton#primaryButton:hover { background: #212529; }
QPushButton#secondaryButton {
    background: #ffffff; color: #212529; border: 1px solid #ced4da; border-radius: 8px;
    padding: 8px 18px; font-weight: 600;
}
QPushButton#secondaryButton:hover { background: #e9ecef; border-color: #adb5bd; }

QMenu { background: #ffffff; border: 1px solid #ced4da; padding: 5px; }
QMenu::item { padding: 7px 24px 7px 12px; border-radius: 6px; color: #212529; }
QMenu::item:selected { background: #e9ecef; color: #212529; }
QMenu::separator { height: 1px; background: #dee2e6; margin: 4px 8px; }

/* ---------- map section ---------- */
#mapSection { background: #f8f9fa; }
#mapTabbar { background: #e6edf1; border-bottom: 1px solid #8fa3b0; min-height: 44px; max-height: 44px; }
#mapTab { background: #f8f9fa; border: 1px solid #dee2e6; border-bottom: 0; border-radius: 8px; min-height: 32px; max-height: 32px; }
#mapTabText { font-weight: 700; color: #212529; }
#mapContext { color: #495057; font-size: 12.5px; }
QToolButton#paneButton {
    background: #ffffff; border: 1px solid #ced4da; border-radius: 7px;
    padding: 5px 11px; font-weight: 600; color: #343a40;
}
QToolButton#paneButton:hover { background: #e9ecef; }
QToolButton#paneButton:checked { background: #dee2e6; border-color: #adb5bd; color: #212529; }

#mapLabel { background: rgba(248, 249, 250, 235); border: 1px solid #ced4da; border-radius: 9px; }
#mapLabelText { font-weight: 700; color: #212529; }
#sampleChip {
    background: #dee2e6; color: #343a40; border-radius: 5px; padding: 1px 7px;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1px;
}
#mapNav { background: rgba(248, 249, 250, 240); border: 1px solid #ced4da; border-radius: 10px; }
QToolButton#navButton { background: transparent; border: 0; border-radius: 7px; }
QToolButton#navButton:hover { background: #dee2e6; }
#navDivider { background: #dee2e6; }
#mapAnnotation {
    background: rgba(248, 249, 250, 235); border: 1px solid #ced4da; border-radius: 8px;
    padding: 4px 11px; color: #212529; font-weight: 600; font-size: 12.5px;
}
#drawHint {
    background: #212529; color: #f8f9fa; border-radius: 9px; padding: 8px 16px; font-weight: 600;
}
#previewBanner { background: #e9ecef; border: 1px solid #adb5bd; border-radius: 10px; }
#bannerText { color: #212529; font-weight: 700; }
QPushButton#discardButton {
    background: #343a40; color: #f8f9fa; border: 0; border-radius: 6px;
    padding: 4px 13px; font-weight: 700;
}
QPushButton#discardButton:hover { background: #212529; }

#pixelInspector { background: rgba(248, 249, 250, 245); border: 1px solid #ced4da; border-radius: 12px; }
#inspectorHead { font-size: 11.5px; font-weight: 800; letter-spacing: 1px; color: #212529; }
#liveLabel { color: #343a40; font-size: 11px; font-weight: 800; letter-spacing: 1px; }
#coordName { color: #495057; }
#coordValue { font-family: "Consolas", "SF Mono", "DejaVu Sans Mono", monospace; font-weight: 600; font-size: 13.5px; color: #212529; }
#coordUnit { color: #adb5bd; font-size: 12px; }
#pixelType { font-weight: 700; color: #212529; }
#pixelValue { font-size: 25px; font-weight: 800; color: #212529; }
#pixelUnit { color: #495057; font-weight: 600; }
#pixelMeta { color: #495057; font-size: 12px; }

#mapFooter { background: #e9ecef; border-top: 1px solid #dee2e6; min-height: 36px; max-height: 36px; }
QToolButton#scaleButton {
    background: #ffffff; border: 1px solid #ced4da; border-radius: 7px;
    padding: 4px 10px; font-weight: 600; color: #212529;
}
QToolButton#scaleButton:hover { background: #e9ecef; }
QToolButton#scaleButton::menu-indicator { image: none; width: 0; }
#footerTool { color: #343a40; font-weight: 600; }
#footerCrs { color: #495057; font-size: 12.5px; }

/* ---------- status bar & toast ---------- */
#statusbar { background: #f8f9fa; border-top: 1px solid #dee2e6; }
#statusbar QLabel { color: #212529; font-size: 12.5px; }
#statusbar #statusHelp { color: #495057; }
#statusSeparator { background: #ced4da; }
#toast {
    background: #45484c; color: #f8f9fa; border-radius: 10px;
    padding: 11px 20px; font-weight: 600; font-size: 13.5px;
}